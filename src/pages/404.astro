---
import BaseLayout from "../layouts/BaseLayout.astro";
import PillButton from "../components/ui/PillButton.astro";
import { site } from "../data/site";

/**
 * GitHub Pages serves this page for any unknown path, which makes it the hook for
 * short links: the script looks the path up in the short-link sheet and redirects,
 * and only shows the 404 itself when nothing matches. Until then the page shows a
 * plain "Redirecting…" screen, so a short link never flashes a 404 first.
 */
---

<BaseLayout title={`Page not found — ${site.name}`} noindex>
  <!-- `data-lookup` switches to the redirect screen while the lookup runs and holds
       the 404 title to restore if it fails. The timeout is a fallback in case the
       lookup script never runs. -->
  <script is:inline>
    const root = document.documentElement;
    root.dataset.lookup = document.title;
    document.title = "Redirecting…";
    setTimeout(() => {
      if (root.dataset.lookup === undefined) return;
      document.title = root.dataset.lookup;
      delete root.dataset.lookup;
    }, 10000);
  </script>

  <div
    class="hidden min-h-svh items-center justify-center px-gutter in-data-lookup:flex"
  >
    <p class="font-mono text-meta text-sand/70" aria-live="polite">
      Redirecting<span data-destination></span>…
    </p>
  </div>

  <main
    class="flex min-h-svh flex-col items-start justify-center gap-8 px-gutter py-section in-data-lookup:hidden"
  >
    <p class="font-mono text-meta text-caramel">404</p>
    <h1 class="max-w-[15ch] text-hero font-light">
      This page <span class="text-accent">doesn't exist.</span>
    </h1>
    <p class="max-w-[45ch] text-body text-sand/70">
      The link may be mistyped, or the page has moved.
    </p>
    <PillButton variant="cta" icon="arrow-left" href="/">Back home</PillButton>
  </main>
</BaseLayout>

<script>
  import {
    destination,
    fetchShortLinks,
    normalizeSlug,
  } from "../lib/shortlinks";

  async function lookup() {
    let slug: string;
    try {
      slug = normalizeSlug(decodeURIComponent(location.pathname));
    } catch {
      return undefined;
    }
    if (slug === "") return undefined;

    const link = (await fetchShortLinks()).find((link) => link.slug === slug);
    return link && destination(link, location.search);
  }

  function showNotFound() {
    const root = document.documentElement;
    document.title = root.dataset.lookup ?? document.title;
    delete root.dataset.lookup;
  }

  try {
    const url = await lookup();
    if (url) {
      const label = document.querySelector("[data-destination]");
      if (label) label.textContent = ` to ${new URL(url).host}`;
      location.replace(url);
    } else {
      showNotFound();
    }
  } catch {
    showNotFound();
  }
</script>
