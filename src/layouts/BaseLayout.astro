---
import { Font } from "astro:assets";
import { isExternal, site, socials } from "../data/site";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  /** Keep the page out of search results, e.g. the 404 page. */
  noindex?: boolean;
  /** Social card for this page; defaults to the site's. */
  image?: { src: string; width: number; height: number; alt: string };
  /** Extra schema.org nodes for this page, added to the site-wide graph. */
  structuredData?: Record<string, unknown>[];
}

const {
  title = site.title,
  description = site.description,
  noindex = false,
  image = site.ogImage,
  structuredData = [],
} = Astro.props;

const home = new URL("/", Astro.site).href;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image.src, Astro.site);

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${home}#website`,
      url: home,
      name: site.name,
      description: site.description,
      inLanguage: "en",
      publisher: { "@id": `${home}#person` },
    },
    {
      "@type": "Person",
      "@id": `${home}#person`,
      name: site.name,
      alternateName: site.alternateNames,
      url: home,
      email: `mailto:${site.email}`,
      jobTitle: site.jobTitle,
      description: site.description,
      address: { "@type": "PostalAddress", addressCountry: "TW" },
      knowsLanguage: ["en", "zh-TW"],
      affiliation: {
        "@type": "CollegeOrUniversity",
        name: "Chung Yuan Christian University",
      },
      memberOf: {
        "@type": "Organization",
        name: "SITCON",
        url: "https://sitcon.org",
      },
      sameAs: socials
        .filter((link) => isExternal(link.href))
        .map((link) => link.href),
    },
    ...structuredData,
  ],
};
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    <meta name="theme-color" content="#0d0b09" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    {noindex && <meta name="robots" content="noindex" />}
    {!noindex && <link rel="canonical" href={canonical} />}
    <link rel="sitemap" href="/sitemap-index.xml" />
    <title>{title}</title>

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={String(image.width)} />
    <meta property="og:image:height" content={String(image.height)} />
    <meta property="og:image:alt" content={image.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={image.alt} />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />

    <Font cssVariable="--font-geist" preload />
    <Font cssVariable="--font-geist-mono" />
    <Font cssVariable="--font-archivo" preload />
  </head>
  <body id="top">
    <slot />
    <script>
      import { initLetterWaves } from "../scripts/letter-wave";
      import { initPills } from "../scripts/pill";
      import { initReveal } from "../scripts/reveal";

      initReveal();
      initPills();
      initLetterWaves();
    </script>
  </body>
</html>
