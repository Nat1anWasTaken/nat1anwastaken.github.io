---
import type { CollectionEntry } from "astro:content";
import PillButton from "../ui/PillButton.astro";
import SplitLetters from "../ui/SplitLetters.astro";

/**
 * One position on the Experience timeline. Hovering or focusing the row drives its
 * arrow button and the particle thread (scripts/scenes/experience.ts), and orbits the
 * dust around the button.
 */
interface Props {
  entry: CollectionEntry<"experience">["data"];
  /** Stagger for the reveal fade, in seconds. */
  delay?: number;
}

const { entry, delay = 0 } = Astro.props;
const { period, org, role, href, current } = entry;
const Tag = href ? "a" : "div";
const external = href?.startsWith("http") ?? false;
---

<li
  data-exp-row
  data-current={current ? "" : undefined}
  data-orbit="capsule"
  data-orbit-target="[data-pill]"
  class="reveal-fade"
  style={{ "--delay": `${delay.toFixed(2)}s` }}
>
  <Tag
    href={href}
    target={external ? "_blank" : undefined}
    rel={external ? "noopener" : undefined}
    class:list={[
      "grid grid-cols-[80px_32px_minmax(0,1fr)_auto] items-start gap-x-column py-4 max-sm:grid-cols-[64px_24px_minmax(0,1fr)_auto]",
      href && "focus-ring",
    ]}
  >
    <span class="pt-[0.6em] font-mono text-meta">{period}</span>
    <span
      data-thread-node
      aria-hidden="true"
      class="mt-[1.1em] size-px justify-self-center"></span>
    <span class="flex min-w-0 flex-col gap-2">
      <SplitLetters text={org} class="text-title font-light" />
      <SplitLetters text={role} class="text-subtitle font-light text-accent" />
    </span>
    <PillButton variant="icon" trigger="[data-exp-row]" class="self-center" />
  </Tag>
</li>
